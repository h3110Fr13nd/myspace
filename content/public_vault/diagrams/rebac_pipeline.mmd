    AuthCheck -->|Denied: 403 Forbidden| Redactor["Redaction Filter"]
  end

  subgraph RenderPipeline["3. Polymorphic Dispatch"]
    Sanitizer -->|canvas:id| C1["CanvasViewer (Sub-Canvas)"]
    Sanitizer -->|jupyter:id| C2["JupyterViewer (Cells & Math)"]
    Sanitizer -->|excalidraw:id| C3["ExcalidrawViewer (RoughJS)"]
    Sanitizer -->|mermaid:id| C4["MermaidViewer (Live SVG)"]
    Sanitizer -->|sheet:id| C5["SheetGrid (FortuneSheet)"]
    Sanitizer -->|paper:id| C6["Research Article (KaTeX)"]
    Redactor --> Locked["LockedNodeCard (Redacted)"]
  end

