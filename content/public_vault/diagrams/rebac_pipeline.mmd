graph TD
  subgraph Ingestion["1. Spatial Canvas Ingestion"]
    User["Client Session / UI"] -->|Fetch Canvas GET| Gateway["Astro SSR API Gateway"]
    Gateway -->|Parse Nodes & Edges| Resolver["Universal Resource Resolver"]
  end

  subgraph Authorization["2. Zero-Trust ReBAC Engine"]
