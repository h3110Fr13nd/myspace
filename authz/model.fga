  relation viewer: [user, group#member, service_account, space#member, user:*] or owner or editor or viewer from parent_folder
  relation read_acl: [user, group#member, service_account] or editor or manage_grants or read_acl from parent_folder
  relation denied_viewer: [user, group#member]
  relation denied_editor: [user, group#member]

