NODE_ENV=development
PORT=4321
HOST=0.0.0.0

# PostgreSQL Database Configuration (Host Port 5435)
POSTGRES_DB=workspace_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://${POSTGRES_USER}@localhost:5435/${POSTGRES_DB}

# OpenFGA Authorization Engine (Host Port 8085)
OPENFGA_API_URL=http://localhost:8085
OPENFGA_STORE_ID=01HQ0000000000000000000000

# Cloudflare R2 Object Storage
# Bucket must be created first: Cloudflare Dashboard → R2 → Create bucket
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=foss-blog-assets

# Cloudflare Tunnel
# Get token from: Zero Trust → Networks → Tunnels → your-tunnel → Configure → Docker
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# Meilisearch Engine (Host Port 7705)
MEILI_MASTER_KEY=your_meilisearch_master_key
MEILISEARCH_URL=http://localhost:7705

# Search Engine Provider (meilisearch | postgres)
SEARCH_ENGINE=meilisearch

# Shared secret required by the `x-user-id` service-impersonation header.
# Without this set, the header is ignored entirely and service callers must
# authenticate with a scoped API key. See plan/core-architecture/31-iam-access-visibility-and-policy-troubleshooter.md
INTERNAL_SERVICE_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Observability — `docker compose --profile infra up -d`, then open :3000
# ─────────────────────────────────────────────────────────────────────────────
# Every value below has a working default. `docker compose --profile infra up -d`
# is the entire setup step: Grafana comes up with anonymous Admin access,
# file-provisioned datasources, dashboards and alert rules.
# See plan/core-architecture/32-observability-and-telemetry-stack.md

# Traces. `auto` loads the OTel SDK only when the OTLP endpoint actually answers,
# so a bare `up` (no `infra` profile) costs nothing and logs nothing.
# Values: auto | true | false
OTEL_ENABLED=auto
OTEL_SERVICE_NAME=mechanical-matter
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
# Fraction of root traces sampled, 0..1. Lower this before raising traffic.
OTEL_TRACES_SAMPLER_ARG=1

# Grafana. Set GRAFANA_ANON_ENABLED=false for anything reachable by a network.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ANON_ENABLED=true
GRAFANA_ANON_ROLE=Admin
GRAFANA_DISABLE_LOGIN_FORM=true
GRAFANA_THEME=system

# Bearer secret for GET /api/v1/metrics. Unset in development (the endpoint then
# serves any local caller). In production the app returns 503 without it, so a
# deploy cannot silently expose heap usage, pool sizes and route names.
# Generate with: openssl rand -hex 32
METRICS_TOKEN=

# Alert delivery. Nothing is sent anywhere by default — the Alertmanager always
# has a valid sink, so `--profile infra` works with zero setup and this repo
# keeps its zero-telemetry stance. Set ONE of the two groups below to start
# receiving pages; the other stays inert.
#
# Webhook. Accepts a Slack incoming webhook, Mattermost, Discord or ntfy — all
# take a POST with a text body. Slack-native formatting needs a small relay,
# because Alertmanager cannot template a JSON field name, only its value.
#ALERT_WEBHOOK_URL=
#
# SMTP. All three routing variables are required; a partial config looks enabled
# and silently drops alerts.
#ALERT_SMTP_HOST=smtp.example.com
#ALERT_SMTP_PORT=587
#ALERT_EMAIL_FROM=dummy_mail
#ALERT_EMAIL_TO=dummy_mail
#ALERT_SMTP_USERNAME=
#ALERT_SMTP_PASSWORD=

# Backends. Bound to 127.0.0.1 unless you deliberately publish them.
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9094
LOKI_PORT=3100
TEMPO_PORT=3200
ALLOY_PORT=12345
# Host-side OTLP endpoint, for `astro dev` running outside Docker. Containers
# use http://alloy:4318 on the internal network instead.
OTLP_HTTP_PORT=4318
# Short retention keeps a laptop's disk in check. Logs age out first.
PROMETHEUS_RETENTION_TIME=48h
PROMETHEUS_RETENTION_SIZE=2GB
