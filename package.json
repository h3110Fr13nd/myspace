    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "katex": "^0.18.4",
    "lucide-react": "^1.47.0",
    "marked": "^18.0.9",
    "meilisearch": "^0.60.0",
    "mermaid": "^12.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "rbush": "^4.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "roughjs": "^4.6.6",
