{
  "name": "mechanical-matter",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:otel": "NODE_OPTIONS='--import tsx --import ./instrumentation.ts' astro dev",
    "dev:ws": "tsx scripts/ws_server.ts",
    "build": "astro build",
    "build:instrumentation": "esbuild instrumentation.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/instrumentation.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "migrate:up": "tsx scripts/migrate.ts up",
    "migrate:down": "tsx scripts/migrate.ts down",
    "migrate:status": "tsx scripts/migrate.ts status",
    "migrate:canvas-groups": "tsx scripts/migrate_canvas_groups.ts",
    "migrate:canvas-groups:write": "tsx scripts/migrate_canvas_groups.ts --write",
    "backup:r2": "tsx scripts/backup_postgres_r2.ts",
    "backup:restore-test": "tsx scripts/restore_postgres_backup.ts",
    "backup:openfga": "tsx scripts/backup_openfga_r2.ts",
    "restore:openfga": "tsx scripts/restore_openfga_r2.ts",
    "stateless:bootstrap": "tsx scripts/r2_stateless_bootstrap.ts",
    "vault:sync": "tsx scripts/obsidian-sync-broker.ts",
    "vault:watch": "tsx scripts/obsidian-sync-broker.ts --watch",
    "worker": "tsx scripts/worker.ts",
    "graph:build": "tsx scripts/graph-build.ts",
    "bench:graph-server": "tsx bench/graph-server.bench.ts",
    "bench:seed": "tsx bench/seed-db.ts",
    "test:unit": "playwright test --config=tests/unit/playwright.config.ts",
    "test:integration": "playwright test --config=tests/integration/playwright.config.ts",
    "test:canvas:browser": "playwright test --config=tests/browser/playwright.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install chromium --with-deps"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.0",
    "@astrojs/react": "^6.0.2",
    "@aws-sdk/client-s3": "^3.1106.0",
