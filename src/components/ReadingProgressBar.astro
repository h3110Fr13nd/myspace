---
// ReadingProgressBar.astro
// Universal scroll progress indicator for long-form blog articles, documentation, and research notes.
---

<div id="reading-progress-container" style="position: fixed; top: 0; left: 0; width: 100%; height: 3px; z-index: 99999; pointer-events: none; background: transparent;">
  <div id="reading-progress-bar" style="height: 100%; width: 0%; background: linear-gradient(90deg, #6366f1, #00f2fe); transition: width 0.08s ease-out; box-shadow: 0 0 10px rgba(0, 242, 254, 0.6);"></div>
</div>

<script>
  function updateProgress() {
    const bar = document.getElementById('reading-progress-bar');
    if (!bar) return;

    const scrollTop = window.scrollY || document.documentElement.scrollTop;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;

    if (docHeight <= 0) {
      bar.style.width = '0%';
      return;
    }

    const progress = Math.min(100, Math.max(0, (scrollTop / docHeight) * 100));
    bar.style.width = `${progress}%`;
  }

  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress, { passive: true });
  document.addEventListener('astro:page-load', updateProgress);
  updateProgress();
</script>

