                    "title": "Error log lines for this route",
                    "url": "/explore?left={\"datasource\":\"foss-loki\",\"queries\":[{\"queryType\":\"range\",\"datasource\":{\"type\":\"loki\",\"uid\":\"foss-loki\"},\"expr\":\"{project=\\\"workspace-stack\\\", level=~\\\"50|60|70\\\"} |= \\\"${__value.raw}\\\"\",\"refId\":\"A\"}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "4xx"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "logs",
      "title": "Error log lines",
      "description": "pino lines at error and above. Every line carries a trace_id, and the trace id in the parsed fields is a link into Tempo — so a log line here is one click from the full request, including the OpenFGA checks that produced it.",
      "id": 10,
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "loki",
        "uid": "foss-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "foss-loki"
          },
          "editorMode": "code",
          "expr": "{project=\"workspace-stack\", level=~\"40|50|60|70\"}",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommon": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
