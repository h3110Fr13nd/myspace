      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "route",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "route 1": true,
              "route 2": true
            },
            "renameByName": {
              "route": "route",
