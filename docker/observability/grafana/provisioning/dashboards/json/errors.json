    {
      "type": "timeseries",
      "title": "Error rate by route, split client / server",
      "description": "The 4xx/5xx split is the fastest way to tell a broken deploy from a client hammering an endpoint that correctly refuses it.",
      "id": 7,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "foss-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "foss-prometheus"
          },
          "editorMode": "code",
          "legendFormat": "5xx {{route}}",
          "expr": "topk(8, sum by (route) (rate(foss_http_errors_total{job=\"app\", class=\"server\"}[5m]))) > 0"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "foss-prometheus"
          },
          "editorMode": "code",
          "legendFormat": "4xx {{route}}",
          "expr": "topk(8, sum by (route) (rate(foss_http_errors_total{job=\"app\", class=\"client\"}[5m]))) > 0"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
