{
  "uid": "foss-http-golden-signals",
  "title": "HTTP Golden Signals",
  "description": "Rate / Errors / Duration for the Astro SSR app, split by coarse route (see the route-coarsening in src/middleware.ts).",
  "tags": ["mechanical-matter", "http"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Rate — top routes",
      "id": 1,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "foss-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "foss-prometheus" },
          "editorMode": "code",
          "expr": "topk(10, sum by (route) (rate(foss_http_requests_total{job=\"app\"}[5m])))",
          "legendFormat": "{{route}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Errors — 4xx and 5xx by route",
      "id": 2,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "foss-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "foss-prometheus" },
          "editorMode": "code",
          "expr": "sum by (route) (rate(foss_http_requests_total{job=\"app\", status=~\"5..\"}[5m])) > 0",
          "legendFormat": "5xx {{route}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "foss-prometheus" },
          "editorMode": "code",
          "expr": "sum by (route) (rate(foss_http_requests_total{job=\"app\", status=~\"4..\"}[5m])) > 0",
          "legendFormat": "4xx {{route}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "heatmap",
      "title": "Duration distribution by route",
      "id": 3,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "foss-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "foss-prometheus" },
          "editorMode": "code",
          "expr": "sum by (le, route) (rate(foss_http_request_duration_seconds_bucket{job=\"app\"}[5m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": { "exponent": 0.5, "fill": "dark-orange", "mode": "scheme", "reverse": false, "scale": "exponential", "scheme": "Spectral" },
        "exemplars": { "color": "rgba(255,0,255,0.7)" },
        "filterValues": { "le": 1e-9 },
        "legend": { "show": true },
        "rowsFrame": { "layout": "auto", "value": "le" },
        "tooltip": { "mode": "single", "showColorScale": false },
        "yAxis": { "axisPlacement": "left", "reverse": false, "unit": "s" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "scaleDistribution": { "type": "linear" } }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Route scorecard",
      "description": "One row per coarse route: traffic, error ratio, p95.",
      "id": 4,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "foss-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "foss-prometheus" },
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "expr": "sum by (route) (rate(foss_http_requests_total{job=\"app\"}[5m]))"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "foss-prometheus" },
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "expr": "sum by (route) (rate(foss_http_requests_total{job=\"app\", status=~\"5..\"}[5m])) / clamp_min(sum by (route) (rate(foss_http_requests_total{job=\"app\"}[5m])), 0.0001)"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "foss-prometheus" },
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(foss_http_request_duration_seconds_bucket{job=\"app\"}[5m])))"
        }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "route", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true },
            "renameByName": {
              "Value #A": "req/s",
              "Value #B": "5xx ratio",
              "Value #C": "p95"
            }
          }
        }
      ],
      "options": { "showHeader": true, "footer": { "show": false }, "sortBy": [{ "desc": false, "displayName": "req/s" }] },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "5xx ratio" }, "properties": [{ "id": "unit", "value": "percentunit" }] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "unit", "value": "s" }] },
          {
            "matcher": { "id": "byName", "options": "5xx ratio" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "mode": "gradient", "type": "gauge" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.01 }] } },
              { "id": "min", "value": 0 }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Node runtime (app process)",
      "description": "Default prom-client process metrics. Useful when a page feels slow and you need to know whether it is CPU, heap, or event-loop delay.",
      "id": 5,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "foss-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "foss-prometheus" },
          "editorMode": "code",
          "expr": "foss_nodejs_eventloop_lag_p99_seconds{job=\"app\"}",
          "legendFormat": "eventloop lag p99"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "foss-prometheus" },
          "editorMode": "code",
          "expr": "foss_nodejs_heap_size_used_bytes{job=\"app\"}",
          "legendFormat": "heap used"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "foss-prometheus" },
          "editorMode": "code",
          "expr": "rate(foss_process_cpu_seconds_total{job=\"app\"}[5m])",
          "legendFormat": "cpu cores"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 8,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "short"
        },
        "overrides": []
      }
    }
  ],
  "annotations": { "list": [] }
}
