# LaTeXML conversion service (TeX → HTML for paper alternate views).
# Built from the pinned vendor/latexml submodule + Debian packages.
FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      latexml poppler-utils python3 python3-http-server \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /data/tex /cache
WORKDIR /app
COPY server.py /app/

EXPOSE 8080
CMD ["python3", "/app/server.py"]
